// SQ8 三节汽车运输车中段专用模板。
// c11 的侧视 xoff 是 -95 / -115（内容宽 209px），而头尾节用 standard 的 -110（内容 220px），
// 中段艺术整体偏右 10px：头-中接缝多出 15px 缝、中-尾接缝压进 4px。
// 把两个侧视改成 -105（= 内容居中），两处接缝各留 5~6px，与客车一致。
template template_std_sq8mid (a, b) {
    [   0,   0,   41, 190,  -16,  -92, "gfx/"+a+"/"+b+"_32bpp.png"]
